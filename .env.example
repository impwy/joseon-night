# 로컬 Docker Compose 인프라 기본값입니다.
JOSEON_NIGHT_DB_URL=jdbc:postgresql://127.0.0.1:15432/joseon_night
JOSEON_NIGHT_DB_USERNAME=joseon
JOSEON_NIGHT_DB_PASSWORD=local-secret
JOSEON_NIGHT_REDIS_HOST=127.0.0.1
JOSEON_NIGHT_REDIS_PORT=16379
JOSEON_NIGHT_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:29092
JOSEON_NIGHT_COMPOSE_FILE=game-core/compose.yaml

# 로컬 서버와 데스크톱 연결 기본값입니다.
JOSEON_NIGHT_REST_PORT=8080
JOSEON_NIGHT_GAME_PORT=8081
JOSEON_NIGHT_SESSION_COOKIE_SECURE=false
JOSEON_NIGHT_API_URL=http://127.0.0.1:8080

# 인증의 공개 가능한 로컬 기본값입니다.
JOSEON_NIGHT_GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/api/v1/auth/google/callback/google
JOSEON_NIGHT_JWT_ISSUER=joseon-night
JOSEON_NIGHT_JWT_AUDIENCE=joseon-night-desktop
JOSEON_NIGHT_JWT_ACCESS_TOKEN_SECONDS=1800

# Google Cloud Console에서 OAuth 클라이언트를 발급한 뒤 아래 두 값을 직접 입력하세요.
# 승인된 리디렉션 URI에는 다음 주소를 등록합니다.
# http://127.0.0.1:8080/api/v1/auth/google/callback/google
JOSEON_NIGHT_GOOGLE_CLIENT_ID=
JOSEON_NIGHT_GOOGLE_CLIENT_SECRET=

# 사용자 식별자 보호용 비밀값입니다. 32자 이상으로 직접 생성해 입력하세요.
JOSEON_NIGHT_GOOGLE_SUBJECT_HMAC_SECRET=

# X.509 공개키와 PKCS#8 개인키의 DER 데이터를 각각 Base64 한 줄로 입력하세요.
JOSEON_NIGHT_JWT_PUBLIC_KEY_BASE64=
JOSEON_NIGHT_JWT_PRIVATE_KEY_BASE64=
